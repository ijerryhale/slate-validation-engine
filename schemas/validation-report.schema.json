{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/slate-validation-engine/schemas/validation-report.schema.json",
  "title": "Slate Validation Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "summary",
    "findings",
    "operatorText",
    "validationResultPayload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warning",
        "blocker"
      ]
    },
    "summary": {
      "$ref": "#/definitions/summary"
    },
    "nextFinding": {
      "anyOf": [
        {
          "$ref": "#/definitions/finding"
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "operatorText": {
      "type": "string"
    },
    "validationResultPayload": {
      "type": "object",
      "required": [
        "schemaVersion",
        "findings"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/resultFinding"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "summary": {
      "type": "object",
      "required": [
        "blockers",
        "warnings",
        "total"
      ],
      "properties": {
        "blockers": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "category",
        "scope",
        "title",
        "evidence",
        "fallbackUsed",
        "identitySource"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "blocker"
          ]
        },
        "category": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "fallbackUsed": {
          "type": "boolean"
        },
        "identitySource": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "resultFinding": {
      "type": "object",
      "required": [
        "code",
        "scope",
        "evidence",
        "fallbackUsed"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "fallbackUsed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
