<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xml:lang="eng">
  <head>
    <styling>
      <style xml:id="s1" tts:fontFamily="Helvetica" tts:fontSize="100%" tts:textAlign="center" xmlns:tts="http://www.w3.org/ns/ttml#styling"/>
    </styling>
    <layout>
      <region xml:id="bottom" tts:origin="10% 78%" tts:extent="80% 18%" xmlns:tts="http://www.w3.org/ns/ttml#styling"/>
    </layout>
  </head>
  <body region="bottom" style="s1">
    <div>
      <p begin="00:00:03.000" end="00:00:07.000">EN: Mara: The first cue is valid.<br/>Clock reads 00:00:03.000.</p>
      <p begin="00:00:10.000" end="00:00:14.000">EN: Jules: This XML fixture is malformed on purpose.<br/>Clock reads 00:00:10.000.</p>
      <p begin="00:00:16.000" end="00:00:20.000">EN: Mara: The document never closes this paragraph cleanly.<br/>Clock reads 00:00:16.000.
    </div>
  </body>
</tt>
