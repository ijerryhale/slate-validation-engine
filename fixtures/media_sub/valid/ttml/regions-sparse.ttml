<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml"
    xmlns:ttp="http://www.w3.org/ns/ttml#parameter"
    xmlns:layout="http://www.w3.org/ns/ttml#styling"
    ttp:timeBase="media"
    xml:lang="en-US">
  <head>
    <layout>
      <region xml:id="caption" layout:origin="10% 78%" layout:textAlign="center"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="0s" end="3s" region="caption">Sparse region cue.</p>
      <p begin="3s" end="5s">Unassigned cue stays distinct.</p>
      <p begin="00:01:44.000" end="00:01:45.900">EN: Mara: Final picture cue for regions sparse.<br/>Clock reads 00:01:44.000.</p>
    </div>
  </body>
</tt>
