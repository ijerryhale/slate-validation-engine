<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xml:lang="eng">
  <head>
    <styling>
      <style xml:id="s1" tts:fontFamily="Helvetica" tts:fontSize="100%" tts:textAlign="center" xmlns:tts="http://www.w3.org/ns/ttml#styling"/>
    </styling>
    <layout>
      <region xml:id="bottomCenter" tts:origin="10% 78%" tts:extent="80% 18%" xmlns:tts="http://www.w3.org/ns/ttml#styling"/>
      <region xml:id="bottomLeft" tts:origin="8% 76%" tts:extent="80% 18%" xmlns:tts="http://www.w3.org/ns/ttml#styling"/>
      <region xml:id="bottomRight" tts:origin="12% 77%" tts:extent="80% 18%" xmlns:tts="http://www.w3.org/ns/ttml#styling"/>
    </layout>
  </head>
  <body region="bottomCenter" style="s1">
    <div>
      <p begin="00:00:04.000" end="00:00:09.000" region="bottomCenter">EN: Mara: Intake bay is live for the new manifest.<br/>Clock reads 00:00:04.000.</p>
      <p begin="00:00:12.000" end="00:00:17.000" region="bottomLeft">EN: Jules: Copy. Subtitle feed stays locked here.<br/>Clock reads 00:00:12.000.</p>
      <p begin="00:00:20.000" end="00:00:25.000" region="bottomRight">EN: Mara: Hold the frame while I verify sync.<br/>Clock reads 00:00:20.000.</p>
      <p begin="00:00:28.000" end="00:00:33.000" region="bottomCenter">EN: Jules: This pass should stay clean end to end.<br/>Clock reads 00:00:28.000.</p>
      <p begin="00:00:36.000" end="00:00:41.000" region="bottomLeft">EN: Mara: Keep this one as the moving-region control.<br/>Clock reads 00:00:36.000.</p>
    </div>
  </body>
</tt>
