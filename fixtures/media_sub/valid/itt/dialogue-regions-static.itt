<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xml:lang="eng">
  <head>
    <styling>
      <style xml:id="s1" tts:fontFamily="Helvetica" tts:fontSize="100%" tts:textAlign="center" xmlns:tts="http://www.w3.org/ns/ttml#styling"/>
    </styling>
    <layout>
      <region xml:id="bottomCenter" tts:origin="10% 78%" tts:extent="80% 18%" xmlns:tts="http://www.w3.org/ns/ttml#styling"/>
    </layout>
  </head>
  <body region="bottomCenter" style="s1">
    <div>
      <p begin="00:00:04.000" end="00:00:09.500">EN: Mara: Stand by at the intake door.<br/>Clock reads 00:00:04.000.</p>
      <p begin="00:00:11.750" end="00:00:17.250">EN: Jules: Copy. The manifest tablet just refreshed.<br/>Clock reads 00:00:11.750.</p>
      <p begin="00:00:20.000" end="00:00:25.500">EN: Mara: Keep eyes on caption sync through this pass.<br/>Clock reads 00:00:20.000.</p>
      <p begin="00:00:28.250" end="00:00:33.750">EN: Jules: Feed is steady. No routing change on my side.<br/>Clock reads 00:00:28.250.</p>
      <p begin="00:00:36.500" end="00:00:42.000">EN: Mara: Good. Hold the lower frame line.<br/>Clock reads 00:00:36.500.</p>
      <p begin="00:00:44.750" end="00:00:50.250">EN: Jules: We are clean through the next handoff.<br/>Clock reads 00:00:44.750.</p>
      <p begin="00:01:44.000" end="00:01:45.005">EN: Mara: Final picture cue for dialogue regions static.<br/>Clock reads 00:01:44.000.</p>
    </div>
  </body>
</tt>
